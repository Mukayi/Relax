diff --git a/relax/utils/straggler/runtime.py b/relax/utils/straggler/runtime.py
index 4df5aab..cf6ff8c 100644
--- a/relax/utils/straggler/runtime.py
+++ b/relax/utils/straggler/runtime.py
@@ -295,6 +295,36 @@ def trace_dir(args: Any) -> str:
 
 _PROFILER: StragglerProfiler | None = None
 
+# EXPERIMENT ONLY (do not merge): host-stall injection for the detection regression on the follow-up code.
+# Global rank STRAGGLER_INJECT_SLEEP_RANK sleeps STRAGGLER_INJECT_SLEEP_MS at "rollout_end" or "step_start"
+# for rollouts [STRAGGLER_INJECT_SLEEP_START, STRAGGLER_INJECT_STOP).
+_INJECT_RANK = int(os.environ.get("STRAGGLER_INJECT_SLEEP_RANK", "-1"))
+_INJECT_S = float(os.environ.get("STRAGGLER_INJECT_SLEEP_MS", "0")) / 1000.0
+_INJECT_AT = os.environ.get("STRAGGLER_INJECT_SLEEP_AT", "rollout_end")
+_INJECT_START = int(os.environ.get("STRAGGLER_INJECT_SLEEP_START", "0"))
+_INJECT_STOP = int(os.environ.get("STRAGGLER_INJECT_STOP", str(1 << 30)))
+_CUR_ROLLOUT = 0
+
+
+def straggler_inject_set_rollout(rollout_id: int) -> None:
+    global _CUR_ROLLOUT
+    _CUR_ROLLOUT = rollout_id
+
+
+def straggler_inject_sleep(where: str = "rollout_end") -> None:
+    import time
+
+    import torch.distributed as dist
+
+    if (
+        _INJECT_S > 0
+        and where == _INJECT_AT
+        and _INJECT_START <= _CUR_ROLLOUT < _INJECT_STOP
+        and dist.is_initialized()
+        and dist.get_rank() == _INJECT_RANK
+    ):
+        time.sleep(_INJECT_S)
+
 
