From deedfab0476342af61a44ff7980203c9f0c5c84e Mon Sep 17 00:00:00 2001
From: Mukayi <1515982581@qq.com>
Date: Thu, 22 Oct 2026 00:15:00 +0800
Subject: [PATCH 05/11] fix(metrics): take the step's batch before the backend
 fan-out

report_step read the step's buffered metrics, awaited the backend
fan-out in a worker thread, then cleared the step. A /log_metrics_batch
for the same step that landed during the await was appended to the
batch being reported and then cleared with it, so it was never reported.

Take the batch atomically (pop) before the await instead. Metrics that
arrive meanwhile start a new batch and go out with the next report of
that step. If the fan-out raises, the taken batch is put back ahead of
anything added since, as before. Cancellation is not restored: the
worker thread still finishes the report, so restoring would send it
twice.

Tests: a gated backend holds the first report while a metric for the
same step is ingested; the metric is reported once, by the next report.
The existing slow-backend test now also checks that its mid-report
ingest is still buffered afterwards. Both fail on the previous commit.
A third test checks that a report which raises keeps its batch.

(cherry picked from commit fbb32be3aa38802b85cbb425dcfa76489deaa965)
---
 relax/utils/metrics/service.py               | 28 ++++++++-
 tests/utils/test_metrics_client_transport.py | 62 +++++++++++++++++++-
 2 files changed, 86 insertions(+), 4 deletions(-)

diff --git a/relax/utils/metrics/service.py b/relax/utils/metrics/service.py
index 58b6649..9d22b8c 100644
--- a/relax/utils/metrics/service.py
+++ b/relax/utils/metrics/service.py
@@ -101,6 +101,22 @@ class MetricsBuffer:
             if step in self._buffer:
                 del self._buffer[step]
 
+    def take_step(self, step: int) -> List[Dict[str, Any]]:
+        """Remove and return the metrics buffered for ``step``.
+
+        Metrics added afterwards start a new batch for the same step.
+        """
+        with self._lock:
+            return self._buffer.pop(step, [])
+
+    def restore_step(self, step: int, metrics: List[Dict[str, Any]]):
+        """Put a batch from :meth:`take_step` back ahead of anything added
+        since."""
+        if not metrics:
+            return
+        with self._lock:
+            self._buffer[step][:0] = metrics
+
     def has_metrics_for_step(self, step: int) -> bool:
         with self._lock:
             return step in self._buffer and len(self._buffer[step]) > 0
@@ -283,7 +299,10 @@ class MetricsService:
     async def report_step(self, request: ReportStepRequest) -> Dict[str, Any]:
         try:
             step = request.step
-            metrics = self.metrics_buffer.get_metrics_for_step(step)
+            # Take the batch before the await below: a /log_metrics_batch that
+            # lands while the backends run must stay buffered for the next report
+            # of this step instead of being cleared unreported.
+            metrics = self.metrics_buffer.take_step(step)
 
             metrics_dict = {}
             for metric in metrics:
@@ -296,9 +315,12 @@ class MetricsService:
             # /log_metrics_batch that arrives meanwhile -- the handler itself is
             # cheap, its neighbours are what get slow. Hand it to a worker
             # thread instead.
-            report_results = await asyncio.to_thread(self._report_to_backends, step, metrics_dict)
+            try:
+                report_results = await asyncio.to_thread(self._report_to_backends, step, metrics_dict)
+            except Exception:
+                self.metrics_buffer.restore_step(step, metrics)
+                raise
 
-            self.metrics_buffer.clear_step(step)
             logger.info(f"Reported {len(metrics)} metrics for step {step}")
             return {
                 "status": "success",
diff --git a/tests/utils/test_metrics_client_transport.py b/tests/utils/test_metrics_client_transport.py
index 041fb10..ae2d9ac 100644
--- a/tests/utils/test_metrics_client_transport.py
+++ b/tests/utils/test_metrics_client_transport.py
@@ -10,7 +10,9 @@ exercised the real transport:
   one per request, and it ignores ``HTTP_PROXY`` / ``HTTPS_PROXY`` for what is a
   cluster-local endpoint;
 * the blocking backend fan-out in ``/report_step`` runs off the event loop, so a
-  slow backend does not stall concurrent metric ingestion on the same replica.
+  slow backend does not stall concurrent metric ingestion on the same replica;
+* a metric ingested while that fan-out runs is kept for the next report of the
+  step, and goes out exactly once.
 
 The connection-reuse test drives a real HTTP server and counts accepted TCP
 connections, so it fails if the client goes back to a fresh connection per call.
@@ -239,6 +241,8 @@ def test_slow_backend_does_not_block_concurrent_ingestion():
 
     assert report_result["results"] == {"tensorboard": "success"}
     assert ingest_result["status"] == "success"
+    # The ingest landed after the report took its batch, so it waits for the next one.
+    assert [m["name"] for m in service.metrics_buffer.get_metrics_for_step(1)] == ["train/loss"]
     assert report_ms >= report_sleep_s * 1e3 * 0.9, (
         f"the report finished too fast to have called the backend: {report_ms:.0f} ms"
     )
@@ -254,3 +258,59 @@ def test_slow_backend_does_not_block_concurrent_ingestion():
         f"a /log_metrics_batch that was ready {ingest_delay_s * 1e3:.0f} ms into a "
         f"{report_sleep_s * 1e3:.0f} ms report waited {ingest_waited_ms:.0f} ms -- it queued behind the fan-out"
     )
+
+
+class _GatedAdapter:
+    """Records what it is sent and holds the first call until released."""
+
+    def __init__(self) -> None:
+        self.received = []
+        self.entered = threading.Event()
+        self.release = threading.Event()
+
+    def log(self, data=None, step=None) -> None:
+        self.received.append(dict(data))
+        if len(self.received) == 1:
+            self.entered.set()
+            assert self.release.wait(5), "the test never released the backend"
+
+
+def test_a_metric_ingested_during_a_report_goes_out_with_the_next_report_once():
+    """The batch is taken before the fan-out, so a metric that arrives during
+    it is neither cleared unreported nor sent twice."""
+    adapter = _GatedAdapter()
+    service = _service_with_slow_backend(adapter)
+    service.metrics_buffer.add_metric(step=1, metric_name="perf/step_time", metric_value=1.0)
+
+    async def scenario():
+        report = asyncio.create_task(service.report_step(ReportStepRequest(step=1)))
+        assert await asyncio.to_thread(adapter.entered.wait, 5), "the report never reached the backend"
+        ingest = await service.log_metrics_batch(LogMetricsBatchRequest(step=1, metrics={"train/loss": 0.5}))
+        adapter.release.set()
+        first = await report
+        second = await service.report_step(ReportStepRequest(step=1))
+        third = await service.report_step(ReportStepRequest(step=1))
+        return ingest, first, second, third
+
+    ingest, first, second, third = asyncio.run(scenario())
+
+    assert ingest["status"] == "success"
+    assert first["results"] == {"tensorboard": "success"}
+    assert second["results"] == {"tensorboard": "success"}
+    assert third["results"] == {}
+    assert adapter.received == [{"perf/step_time": 1.0}, {"train/loss": 0.5}]
+    assert not service.metrics_buffer.has_metrics_for_step(1)
+
+
+def test_a_report_that_raises_keeps_its_batch_for_the_next_report():
+    service = _service_with_slow_backend(_GatedAdapter())
+    service.metrics_buffer.add_metric(step=1, metric_name="perf/step_time", metric_value=1.0)
+
+    def fail(step, metrics_dict):
+        raise RuntimeError("backend thread failed")
+
+    service._report_to_backends = fail
+    result = asyncio.run(service.report_step(ReportStepRequest(step=1)))
+
+    assert result["status"] == "error"
+    assert [m["name"] for m in service.metrics_buffer.get_metrics_for_step(1)] == ["perf/step_time"]
