From 6450322e4bb2ed0cfad20746c3cf8aa45135121c Mon Sep 17 00:00:00 2001
From: Mukayi <1515982581@qq.com>
Date: Wed, 7 Oct 2026 13:25:43 +0800
Subject: [PATCH 09/12] EXPERIMENT ONLY: in-run on/off A/B toggle for straggler
 overhead (do not merge)

Off rollouts also skip note_schedule and note_microbatch_tokens; the final code has no
delivered().
---
 relax/backends/megatron/actor.py |  6 +++++-
 relax/backends/megatron/model.py |  3 +++
 relax/utils/straggler/runtime.py | 24 +++++++++++++++++++++---
 3 files changed, 29 insertions(+), 4 deletions(-)

diff --git a/relax/backends/megatron/actor.py b/relax/backends/megatron/actor.py
index f41b98a..6c9be0f 100644
--- a/relax/backends/megatron/actor.py
+++ b/relax/backends/megatron/actor.py
@@ -2796,10 +2796,14 @@ class MegatronTrainRayActor(TrainRayActor):
     def _log_perf_data(self, rollout_id: int, total_lengths: Sequence[int]) -> None:
         """``log_perf_data`` plus the straggler scalars of any analysed window;
         every rank must call it (the profiler gathers once per window)."""
+        from ...utils.straggler.runtime import straggler_ab_active, straggler_ab_set_step
+
+        active = self.straggler is not None and straggler_ab_active()
         extra = None
-        if self.straggler is not None:
+        if active:
             extra = self.straggler.step_metrics(rollout_id, int(sum(total_lengths)))
         log_perf_data(rollout_id, self.args, flops_counter=self.flops_counter, extra_metrics=extra)
+        straggler_ab_set_step(rollout_id + 1)
         # EXPERIMENT ONLY: injection clock + end-of-rollout sleep
         from ...utils.straggler.runtime import straggler_inject_set_rollout, straggler_inject_sleep
 
diff --git a/relax/backends/megatron/model.py b/relax/backends/megatron/model.py
index fb20e70..5bfc309 100644
--- a/relax/backends/megatron/model.py
+++ b/relax/backends/megatron/model.py
@@ -1516,6 +1516,9 @@ def train(
     config = get_model_config(model[0])
     config.grad_scale_func = optimizer.scale_loss
     config.timers = straggler_timers("train")
+    # EXPERIMENT ONLY (exp/task11-interleave-v3): the optimizer's config is set once at setup; follow the A/B toggle.
+    if getattr(optimizer, "config", None) is not None:
+        optimizer.config.timers = config.timers
     # train() is invoked once per rollout in Relax (vs. once per run upstream),
     # so guard the sync-func setup to be idempotent — re-assigning would trip
     # Megatron's "no_sync_func must be None" assert on rollout 1+.
diff --git a/relax/utils/straggler/runtime.py b/relax/utils/straggler/runtime.py
index cf6ff8c..10ae384 100644
--- a/relax/utils/straggler/runtime.py
+++ b/relax/utils/straggler/runtime.py
@@ -326,6 +326,24 @@ def straggler_inject_sleep(where: str = "rollout_end") -> None:
         time.sleep(_INJECT_S)
 
 
+# EXPERIMENT ONLY (not for the PR): in-run on/off A/B for the overhead experiment.
+# STRAGGLER_AB_PERIOD=N toggles the profiler every N rollouts; STRAGGLER_AB_PHASE=0|1 picks
+# whether block 0 is on. Off rollouts get config.timers=None and skip step_metrics, note_schedule
+# and note_microbatch_tokens, i.e. the code path of a run without the profiler.
+_AB_PERIOD = int(os.environ.get("STRAGGLER_AB_PERIOD", "0"))
+_AB_PHASE = int(os.environ.get("STRAGGLER_AB_PHASE", "0"))
+_AB_ON = _AB_PERIOD <= 0 or _AB_PHASE % 2 == 0
+
+
+def straggler_ab_set_step(rollout_id: int) -> None:
+    global _AB_ON
+    _AB_ON = _AB_PERIOD <= 0 or ((rollout_id // _AB_PERIOD) + _AB_PHASE) % 2 == 0
+
+
+def straggler_ab_active() -> bool:
+    return _AB_ON
+
+
 def install_straggler_profiler(role: str, args: Any) -> StragglerProfiler | None:
     """Create the process-wide profiler if it is enabled and ``role`` runs
     training steps; ``None`` otherwise.
@@ -438,7 +456,7 @@ def _timers_for(collector: StragglerCollector, phase: str) -> StragglerTimers:
 def straggler_timers(phase: str) -> StragglerTimers | None:
     """The ``config.timers`` value for ``phase``: ``None`` without a profiler,
     which is what Relax assigns anyway."""
-    return _timers_for(_PROFILER.collector, phase) if _PROFILER is not None else None
+    return _timers_for(_PROFILER.collector, phase) if _PROFILER is not None and _AB_ON else None
 
 
 def interleaved_schedule_table(
@@ -465,7 +483,7 @@ def note_schedule(model: Sequence[Any], num_microbatches: int, forward_only: boo
     """Report the forward-backward call about to run, so that under interleaved
     PP each bracket takes its micro-batch and model chunk; a no-op without a
     profiler."""
-    if _PROFILER is not None:
+    if _PROFILER is not None and _AB_ON:
         _PROFILER.collector.note_schedule(
             partial(interleaved_schedule_table, model, num_microbatches, forward_only), forward_only
         )
@@ -477,5 +495,5 @@ def note_microbatch_tokens(total_lengths: Any) -> None:
 
     Only a host-side list is summed: summing a device tensor would synchronize.
     """
-    if _PROFILER is not None and isinstance(total_lengths, (list, tuple)):
+    if _PROFILER is not None and _AB_ON and isinstance(total_lengths, (list, tuple)):
         _PROFILER.collector.note_tokens(int(sum(total_lengths)))
-- 
